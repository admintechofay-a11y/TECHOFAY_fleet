{
  "name": "technofay-fleet-transport-platform",
  "version": "1.0.0",
  "description": "Production MERN Fleet and Transport Management Web Application",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:phase1": "node --test tests/phase1-baseline.test.js",
    "test:phase2-workflows": "node --test tests/phase2-workflows.test.js",
    "test:phase2": "node --test apps/api/tests/phase2-auth-rbac.test.js",
    "test:phase3": "node --test apps/api/tests/phase3-master-data.test.js",
    "test:phase4": "node --test apps/api/tests/phase4-loads-documents.test.js",
    "test:phase5": "node --test apps/api/tests/phase5-trips-pod.test.js",
    "test:phase6": "node --test apps/api/tests/phase6-excel-bulk.test.js",
    "test:phase7": "node --test apps/api/tests/phase7-whatsapp.test.js",
    "test:phase8": "node --test apps/api/tests/phase8-dashboard-reports.test.js",
    "test:phase9": "node --test apps/api/tests/phase9-e2e-hardening.test.js",
    "test:phase10": "node --test apps/api/tests/phase10-enhancements.test.js",
    "test": "node scripts/run-all-tests.js",
    "check:env": "node scripts/health-check.js",
    "start:api": "node apps/api/src/server.js",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build"
  },
  "keywords": [
    "mern",
    "fleet-management",
    "transport",
    "logistics",
    "lorry-receipt",
    "bilty",
    "typescript"
  ],
  "author": "Techofay Global Ventures",
  "license": "UNLICENSED"
}
