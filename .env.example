# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: MERN Fleet & Transport Management Platform
# IMPORTANT: This is a safe template. NEVER commit real credentials or secrets.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Local MongoDB connection (Windows service or replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/fleet_transport_dev
MONGODB_DEBUG=false

# Client URL (for CORS and document link redirects)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Authentication & Session Security (Replace placeholders in local .env)
# Minimum 32-character random string required for JWT/Session secrets in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Document & File Upload Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
STORAGE_MAX_FILE_SIZE_MB=15
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# WhatsApp Communication Adapter
# Allowed providers: fake (local development/testing), interakt, twilio
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=fake
WHATSAPP_API_KEY=
WHATSAPP_APP_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=

# Company & Regional Default Settings
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
DEFAULT_GTA_GST_RATE=5.0
DEFAULT_GTA_SAC_CODE=9965
DEFAULT_WEIGHT_UNIT=MT
DEFAULT_DISTANCE_UNIT=KM

# Seed & Bootstrap Settings (Disabled by default in production)
ENABLE_DEMO_SEED=false
BOOTSTRAP_ADMIN_EMAIL=admin@technofay.com
BOOTSTRAP_ADMIN_PASSWORD=change_on_first_login_secure_password
